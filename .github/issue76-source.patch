diff --git a/src/msg/storage/sqlite.py b/src/msg/storage/sqlite.py
index e261e61..a955cba 100644
--- a/src/msg/storage/sqlite.py
+++ b/src/msg/storage/sqlite.py
@@ -360,10 +360,16 @@ class SqliteSession:
     async def memberships(self, subject):
         if subject is None:
             return ()
-        memberships=tuple(decode(Membership, loads(row[0])) for row in
-                          self.rows("SELECT body FROM memberships WHERE subject=? ORDER BY org", (subject,)))
