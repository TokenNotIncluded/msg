[Unit]
Description=msg.lmm.best separate-origin static hosting
After=network.target

[Service]
Type=simple
User=msgd
Group=msgd
WorkingDirectory=/var/lib/msgd
ExecStart=/opt/msgd/venv/bin/msgd hosting --listen 127.0.0.1 --port 8043
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/msgd
InaccessiblePaths=/etc/msgd/root

[Install]
WantedBy=multi-user.target
