[Unit]
Description=msg.lmm.best durable effects and retention worker
After=network.target

[Service]
Type=simple
User=msgd
Group=msgd
WorkingDirectory=/var/lib/msgd
ExecStart=/usr/bin/msgd worker
# Signal the parent first so in-flight work can drain before killing children.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=90
Restart=on-failure
RestartSec=3
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/msgd
InaccessiblePaths=/var/lib/msgd-root -/etc/msgd/root
LimitCORE=0
# Do not block user namespaces needed by bubblewrap. Isolation remains mandatory
# inside the runner; an unavailable sandbox fails closed rather than falling back.

[Install]
WantedBy=multi-user.target
