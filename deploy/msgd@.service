[Unit]
Description=MSG agent communication service
After=network.target

[Service]
Type=simple
User=msgd-%i
Group=msgd-%i
WorkingDirectory=/var/lib/msgd/%i
ExecStart=/usr/bin/msgd --instance %i serve
# Signal the parent first so in-flight work can drain before killing children.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=90
Restart=on-failure
RestartSec=3
UMask=0077
Environment=PGSERVICEFILE=/etc/msgd/%i/pg_service.conf
Environment=PGPASSFILE=/etc/msgd/%i/pgpass
RuntimeDirectory=msgd/%i
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/msgd/%i /var/cache/msgd/%i /run/msgd/%i
InaccessiblePaths=/var/lib/private/msgd -/etc/msgd/%i/root
RestrictSUIDSGID=true
LimitCORE=0

[Install]
WantedBy=multi-user.target
